# DeepSeek API Key：仅在后端填写，不要放进前端 VITE_* 环境变量。
DEEPSEEK_API_KEY=
# 官方 API 地址，代码会自动追加 /chat/completions；也支持 https://api.deepseek.com/v1。
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认普通对话模型；可改为账户支持的其他模型，例如 deepseek-reasoner。
DEEPSEEK_MODEL=deepseek-chat
# 回答随机性 0~2；科普问答建议较低值。
DEEPSEEK_TEMPERATURE=0.3
# 单次回答最大生成 token 数，当前支持 1~8192。
DEEPSEEK_MAX_TOKENS=1024
# 请求超时秒数，1~180；推理模型可设置为 120 或 180。
DEEPSEEK_TIMEOUT_SECONDS=60
