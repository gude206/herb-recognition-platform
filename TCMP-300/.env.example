# DeepSeek API Key：仅在后端填写，不要放进前端 VITE_* 环境变量。
DEEPSEEK_API_KEY=
# 官方 API 地址，代码会自动追加 /chat/completions；也支持 https://api.deepseek.com/v1。
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认普通对话模型；可改为账户支持的其他模型，例如 deepseek-reasoner。
DEEPSEEK_MODEL=deepseek-chat
# 回答随机性 0~2；科普问答建议较低值。
DEEPSEEK_TEMPERATURE=0.3
# 单次回答最大生成 token 数，当前支持 1~8192。
DEEPSEEK_MAX_TOKENS=1024
# 请求超时秒数，1~180；推理模型可设置为 120 或 180。
DEEPSEEK_TIMEOUT_SECONDS=60

# MySQL 历史记录；数据库账号和密码仅在本地配置。
MYSQL_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=herb_app
MYSQL_PASSWORD=
MYSQL_DATABASE=herb_platform
# 项目独立 MySQL 实例由 start-platform.ps1 自动启动。
MYSQL_MANAGED_LOCAL=false

# 真实账号认证；本机 setup_auth.py 自动生成 CSRF 密钥和管理员。
# 使用 HTTPS 部署时将 AUTH_COOKIE_SECURE 改为 true。
AUTH_CSRF_SECRET=
AUTH_COOKIE_SECURE=false
AUTH_ADMIN_ACCOUNT=admin

# Agent: local direct execution by default; Redis/Celery deployment can enable queue mode.
AGENT_QUEUE_ENABLED=false
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
